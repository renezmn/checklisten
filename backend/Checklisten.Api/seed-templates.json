{
  "kickoff": {
    "id": "kickoff",
    "title": "Kick-Off Meeting",
    "subtitle": "Upgrade auf NvT-V5",
    "tag": "Planung",
    "accent": "brand",
    "meta": [
      {
        "name": "kunde",
        "label": "Kunde",
        "type": "text",
        "required": true
      },
      {
        "name": "datum",
        "label": "Datum des Gesprächs",
        "type": "date",
        "required": true
      },
      {
        "name": "teilnehmer",
        "label": "Teilnehmer (intern)",
        "type": "text"
      }
    ],
    "sections": [
      {
        "title": "NovaTime · Systemanforderungen",
        "items": [
          {
            "id": "os_ziel",
            "type": "multiselect",
            "label": "Ziel-Betriebssystem",
            "options": [
              "Windows 10",
              "Windows 11",
              "Windows Server ab 2016"
            ]
          },
          {
            "id": "upgrade_strategie",
            "type": "select",
            "label": "OS-Upgrade In-Place oder neuer Server?",
            "options": [
              "In-Place Upgrade",
              "Neuer Server → Migration → Auftrag"
            ]
          },
          {
            "id": "sysvor",
            "type": "info",
            "label": "Minimale Systemvoraussetzungen",
            "text": "2 GHz Prozessor · Empfehlung: mind. 2 Kerne · mind. 8 GB RAM (je nach OS)\nNovaTime-DB: Größe von V4 übernehmen\nArchiv-DB: Größe von V4 + 1 MB / Mitarbeiter jährlich über den gesamten Archivzeitraum (Standard 10 Jahre)."
          }
        ]
      },
      {
        "title": "Upgrade-Prozess · Planung & Ausführung",
        "items": [
          {
            "id": "datum_server",
            "type": "date",
            "label": "Server fertig zum"
          },
          {
            "id": "datum_migr",
            "type": "datetime-local",
            "label": "NvT-Migration (Datum/Uhrzeit)"
          },
          {
            "id": "datum_update",
            "type": "datetime-local",
            "label": "NvT-Update (Datum/Uhrzeit)"
          },
          {
            "id": "downtime",
            "type": "info",
            "label": "Geplante Downtimes",
            "text": "NovaTime ist ein/mehrere Tage offline. Stationäre Terminals puffern Daten in der Zwischenzeit."
          },
          {
            "id": "ap_it",
            "type": "text",
            "label": "Ansprechpartner IT"
          },
          {
            "id": "ap_hr",
            "type": "text",
            "label": "Ansprechpartner HR"
          },
          {
            "id": "zugriff",
            "type": "multiselect",
            "label": "Zugriff auf den Server",
            "options": [
              "Dauerzugang PCVisit mit eigenem Admin-User",
              "Fernwartung mit IT-Abteilung über PCVisit",
              "TeamViewer (muss beim Kunden lizensiert sein)",
              "Andere"
            ]
          },
          {
            "id": "zugriff_andere",
            "type": "textarea",
            "label": "Andere Zugangsart – Details",
            "optional": true
          }
        ]
      },
      {
        "title": "To-Dos im Vorfeld",
        "items": [
          {
            "id": "todo_user_rechte",
            "type": "check",
            "text": "Benutzer und deren Rechte überprüfen",
            "note": "Kann auch nach dem Update erfolgen."
          },
          {
            "id": "todo_mehrplatz",
            "type": "check",
            "text": "Mehrplatzfähigkeit ausreichend lizensiert?",
            "note": "Je nach Berechtigung können Logins in NovaTime-Web auch einen Client-Platz belegen."
          },
          {
            "id": "web_erreichbar",
            "type": "select",
            "label": "NovaTime-Web erreichbar",
            "options": [
              "Nur im Intranet",
              "Von außerhalb erreichbar"
            ]
          },
          {
            "id": "web_domain",
            "type": "text",
            "label": "Domain-Name mit Routing-Port (bei Migration)"
          },
          {
            "id": "ssl",
            "type": "select",
            "label": "SSL-Zertifikat bereitgestellt durch",
            "options": [
              "Kunde",
              "dP elektronik"
            ]
          }
        ]
      },
      {
        "title": "Nach dem Update",
        "items": [
          {
            "id": "fw",
            "type": "info",
            "label": "Firewall Inbound-Regeln",
            "text": "NovaTime-Mails: 25 / 587\nClient-Kommunikation: 11995\nHardware-Terminals: 8000\nNovaTime-Web: 9000"
          },
          {
            "id": "av",
            "type": "info",
            "label": "Virenscanner-Ausnahmen",
            "text": "NvT-Ordner inkl. Unterordner sowie NvT-Dienste von Novatime exkludieren."
          },
          {
            "id": "client_admin",
            "type": "info",
            "label": "NvT-Admin-User",
            "text": "Novatime.exe (Client)"
          },
          {
            "id": "client_sb",
            "type": "select",
            "label": "Sachbearbeiter-Clients",
            "options": [
              "Exe",
              "Web",
              "Beides"
            ]
          },
          {
            "id": "client_ma",
            "type": "info",
            "label": "Mitarbeiter",
            "text": "Web"
          },
          {
            "id": "einweisung_datum",
            "type": "date",
            "label": "Einweisung mit HR (Datum)"
          }
        ]
      }
    ]
  },
  "rauten": {
    "id": "rauten",
    "title": "Rauten-Update Novatime",
    "subtitle": "Patch-Update innerhalb V4 oder V5",
    "tag": "Patch",
    "accent": "brand",
    "meta": [
      {
        "name": "kunde",
        "label": "Kunde",
        "type": "text",
        "required": true
      },
      {
        "name": "datum",
        "label": "Datum/Uhrzeit",
        "type": "datetime-local",
        "required": true
      },
      {
        "name": "supporter",
        "label": "Supporter",
        "type": "text",
        "required": true
      },
      {
        "name": "vonVersion",
        "label": "Von Version",
        "type": "text",
        "placeholder": "z. B. V4.x.0x #xx"
      },
      {
        "name": "aufVersion",
        "label": "Auf Version",
        "type": "text",
        "placeholder": "z. B. V5.0.01 #xx"
      }
    ],
    "sections": [
      {
        "title": "DB-Vorbereitung auf dem Kundenserver",
        "items": [
          {
            "id": "p1",
            "type": "check",
            "text": "NovaTime öffnen, Hilfe → Info"
          },
          {
            "id": "p2",
            "type": "check",
            "text": "Userverwaltung Basisdaten: Kalender auf „read\" bei allen Usern setzen, sodass keiner den Kalender ändern kann"
          },
          {
            "id": "p3",
            "type": "check",
            "text": "F12 → Allgemein 1: Rückrechendatum auf 03.01.yyyy gesetzt"
          },
          {
            "id": "p4",
            "type": "check",
            "text": "F12 → Allgemein 2 · Urlaubskomfortmodul: bei „Urlaubsverfall\" das Häkchen setzen"
          },
          {
            "id": "p5",
            "type": "check",
            "text": "F12 → Versions-Info"
          },
          {
            "id": "p6",
            "type": "check",
            "text": "Alle NovaTime-Programme beenden"
          },
          {
            "id": "p7",
            "type": "check",
            "text": "Dienste beenden und deinstallieren: nvtcom, nzeitauf, perimex, zdb",
            "note": "DienstStop.bat im Admin-Fenster · Datei → Dienst deinstallieren · in „Dienste\" prüfen, ob alle NovaTime-Dienste verschwunden sind. Workflow beenden. Bei Workflow, Browser-Terminal oder Handy-App sicherstellen, dass kein Zugriff erfolgt (Task Manager prüfen!)."
          },
          {
            "id": "p8",
            "type": "check",
            "text": "Workflow in IIS beenden"
          },
          {
            "id": "p9",
            "type": "check",
            "text": "Komplettsicherung von C:\\NovaTime",
            "note": "Kein Backup, kein Mitleid!"
          }
        ]
      },
      {
        "title": "Update",
        "items": [
          {
            "id": "u1",
            "type": "check",
            "text": "Update-CD mit der neuen Raute auf den Kundenserver übertragen und SETUP.EXE ausführen",
            "note": "Installation: Grundpaket & alle Optionen auswählen. Installationspfad beachten."
          },
          {
            "id": "u2",
            "type": "check",
            "text": "F12 → Grundeinstellungen: folgende Parameter überprüfen und anpassen"
          },
          {
            "id": "u3",
            "type": "check",
            "text": "Dienste als Admin installieren und starten"
          },
          {
            "id": "u4",
            "type": "check",
            "text": "Workflow in IIS starten"
          },
          {
            "id": "u5",
            "type": "check",
            "text": "Systemtest: NovaTime-Software und Info"
          },
          {
            "id": "u6",
            "type": "check",
            "text": "F12 → Version-Info prüfen"
          },
          {
            "id": "u7",
            "type": "check",
            "text": "Automatische Datensicherung prüfen (nicht auf Netzlaufwerken)",
            "note": "Tägliche Sicherung in sieben unterschiedliche Ordner. Falls nicht, anpassen und Pfade aktualisieren. Kunden informieren. Weitere Kopien an anderen Speicherorten muss der Kunde selbst anlegen. Die NovaTime-Sicherungen bleiben auf dem Server, auf dem auch NovaTime läuft."
          },
          {
            "id": "u8",
            "type": "check",
            "text": "Terminals testen (V5-Connect / V4-TermShow)"
          },
          {
            "id": "u9",
            "type": "check",
            "text": "Lampentableau testen"
          },
          {
            "id": "u10",
            "type": "check",
            "text": "Browser-/Bildschirmterminal testen"
          },
          {
            "id": "u11",
            "type": "check",
            "text": "Syslog auf Fehler überprüfen"
          },
          {
            "id": "u12",
            "type": "check",
            "text": "Ggf. Desktop-Verknüpfungen löschen",
            "note": "z. B. ungenutzte Optionen wie Lampentableau, Nv_Connect, …"
          },
          {
            "id": "u13",
            "type": "select",
            "label": "Clients-Update durch",
            "options": [
              "dP elektronik",
              "Kunden",
              "Geteilt"
            ]
          },
          {
            "id": "u14",
            "type": "check",
            "text": "Lokale Installation auf Client-PC",
            "note": "Anleitung auf Server-Desktop speichern und Kunden mitteilen."
          },
          {
            "id": "u15",
            "type": "check",
            "text": "Client-prg auf Netzlaufwerk aktualisieren",
            "note": "Computerverwaltung öffnen (Dieser PC → Verwalten) · Freigegebene Ordner → Sitzungen und geöffnete Dateien prüfen · Dateien aus prg in Client-prg-Verzeichnis kopieren · Verknüpfungen und hinterlegte Ausführpfade kontrollieren und ggf. erneuern."
          },
          {
            "id": "u16",
            "type": "check",
            "text": "Auf User-PCs oder freigegebenem Laufwerk SETUP.exe ausführen",
            "note": "Nur NovaTime + ggf. Optionen wie Lampentableau. Auf dem lokalen Client-PC müssen zusätzlich die Systemdateien installiert sein. Bei neuem PC: lokal Systemdateien installieren! Evtl. User-prg-Ordner aktualisieren und auf Client-PCs kopieren (korrekten Installationspfad beachten)."
          }
        ]
      },
      {
        "title": "Dokumentation & Ablage",
        "items": [
          {
            "id": "d1",
            "type": "check",
            "text": "nvdaten.dba herunterladen und im Kundenverzeichnis ablegen",
            "note": "V:\\Kundendaten\\Kunde\\aktuelle nvdaten.dba – wichtig für Preiskalkulator und Lizenzinfos."
          },
          {
            "id": "d2",
            "type": "check",
            "text": "Neue Lizenzinfo und Version im Teamleader beim Kunden hinterlegen",
            "note": "Unter: 1. Firmeninformationen (Versionsstand NovaTime), 2. Lizenzinformationen (Kopie der Lizenzinfo)."
          },
          {
            "id": "d3",
            "type": "check",
            "text": "Diese Checkliste im Kundenverzeichnis unter Dokumentation ablegen",
            "note": "V:\\Kundendaten\\Kunde\\Dokus"
          }
        ]
      }
    ]
  },
  "update": {
