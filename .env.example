# Kopiere diese Datei zu `.env` und passe die Werte an.
# In .gitignore – wird NICHT eingecheckt.

# Initialpasswort des Seed-Admins (nur wenn die DB noch leer ist)
ADMIN_PASSWORD=einSicheresPasswortBitte

# Version, die das Image stempelt – wird vom CI/Build-Skript überschrieben
APP_VERSION=0.1.0

# URL zur VERSION-Datei im GitHub-Repo (raw). Passe <user> und <repo> an.
# Privates Repo? Dann Personal-Access-Token mit `repo`-Scope vor die URL:
#   https://<token>@raw.githubusercontent.com/<user>/<repo>/main/VERSION
UPDATE_VERSION_URL=https://raw.githubusercontent.com/<user>/<repo>/main/VERSION
